rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only people who open the roster website (signed in anonymously) can read or save.
    match /config/{id}   { allow read, write: if request.auth != null; }
    match /profiles/{id} { allow read, write: if request.auth != null; }
    match /absences/{id} { allow read, write: if request.auth != null; }
    match /wheel/{id}    { allow read, write: if request.auth != null; }
    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
